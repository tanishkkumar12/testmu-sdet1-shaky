    "payload": null,
    "expectedStatus": 404,
    "headerAssertions": {
      "content-type": "application/json"
    },
    "schemaAssertions": "{ type: '.../not-found', title: 'Resource Not Found', status: 404 }"
  },
  {
    "id": "TC-API-006",
    "endpoint": "/api/v1/test-runs/TR-101",
