    "payload": null,
    "expectedStatus": 200,
    "headerAssertions": {
      "content-type": "application/json"
    },
    "schemaAssertions": "Array of TestRun objects matching { id, name, suite, environment, status, durationSec, author, createdAt }"
  },
  {
    "id": "TC-API-002",
    "endpoint": "/api/v1/test-runs",
    "httpMethod": "GET",
    "authType": "None",
    "payload": null,
    "expectedStatus": 401,
    "headerAssertions": {
      "content-type": "application/json"
    },
    "schemaAssertions": "RFC 7807 problem details: { type: '.../unauthorized', title: 'Unauthorized', status: 401 }"
  },
  {
    "id": "TC-API-003",
    "endpoint": "/api/v1/test-runs",
    "httpMethod": "POST",
    "authType": "Bearer valid-token-admin",
    "payload": {
      "name": "Integration Kafka Sync",
      "suite": "Messaging",
      "environment": "staging"
    },
    "expectedStatus": 201,
    "headerAssertions": {
      "content-type": "application/json"
    },
    "schemaAssertions": "Created TestRun object containing generated 'id', status 'running', author 'admin@testmu.ai'"
  },
  {
    "id": "TC-API-004",
    "endpoint": "/api/v1/test-runs",
    "httpMethod": "POST",
    "authType": "Bearer valid-token-admin",
    "payload": {
      "name": "Missing Suite & Environment"
    },
    "expectedStatus": 400,
    "headerAssertions": {
      "content-type": "application/json"
    },
    "schemaAssertions": "{ type: '.../validation-error', status: 400, invalidParams: [{ field: 'suite' }, { field: 'environment' }] }"
  },
  {
    "id": "TC-API-005",
